# Required
DATABASE_URL=postgres://user:password@localhost:5432/truth_accord

# Scrape worker
QUEUE_CONCURRENCY=3           # number of jobs processed in parallel
MAX_RETRIES=3                 # max attempts per job before marking failed
QUEUE_POLL_INTERVAL_MS=5000   # how often the worker polls for new jobs (ms)

# Scraper
SCRAPER_TIMEOUT_MS=30000      # request timeout for static and dynamic scraper (ms)
PLAYWRIGHT_HEADLESS=true      # set to false to show the browser window during dynamic scraping

# RSS feed worker
RSS_FEED_CRON=*/30 * * * *   # cron schedule for RSS ingestion
RSS_FEED_BATCH_SIZE=3         # number of feeds fetched per batch
RSS_FEED_BATCH_DELAY_MS=5000  # delay between batches (ms)

# Research handoff
#
# All AI work (classification, corroboration, author and ownership research,
# truthfulness scoring) now lives in the truth-accord-research Python service.
# Its OLLAMA_*, CORROBORATION_* and SIMILAR_ARTICLE_MIN_SCORE settings live in
# that repo's .env, not here. This worker only scrapes and enqueues.
