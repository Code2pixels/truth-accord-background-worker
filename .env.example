# Required
DATABASE_URL=postgres://user:password@localhost:5432/truth_accord

# Scrape worker
QUEUE_CONCURRENCY=3           # number of jobs processed in parallel
MAX_RETRIES=3                 # max attempts per job before marking failed
QUEUE_POLL_INTERVAL_MS=5000   # how often the worker polls for new jobs (ms)

# Scraper
SCRAPER_TIMEOUT_MS=30000      # request timeout for static and dynamic scraper (ms)
PLAYWRIGHT_HEADLESS=true      # set to false to show the browser window during dynamic scraping

# RSS feed worker
RSS_FEED_CRON=*/30 * * * *   # cron schedule for RSS ingestion
RSS_FEED_BATCH_SIZE=3         # number of feeds fetched per batch
RSS_FEED_BATCH_DELAY_MS=5000  # delay between batches (ms)

# Reference sites crawl
SEARCH_FEED_TIMEOUT_MS=8000           # timeout per reference feed fetch (ms)
REFERENCE_MIN_WORD_LENGTH=4           # minimum word length when extracting keywords (heuristic fallback only)
REFERENCE_MIN_KEYWORD_MATCH=2         # minimum keyword matches to count an article as similar (heuristic fallback only)
SIMILAR_ARTICLE_MIN_SCORE=0.25        # minimum similarity score (0–1) to save a similar article match

# Ollama (topic classification + similar article matching; falls back to heuristics if unavailable)
OLLAMA_BASE_URL=http://10.13.37.54:30068  # Ollama instance URL
OLLAMA_MODEL=gemma4                       # model name to use
OLLAMA_TIMEOUT_MS=60000                   # request timeout (ms)
OLLAMA_MAX_CANDIDATES=200                 # max RSS candidates embedded per job (upper bound before cosine ranking)
OLLAMA_EMBED_MODEL=nomic-embed-text       # embedding model for semantic candidate pre-filter (pull on the Ollama instance)
OLLAMA_PREFILTER_TOPK=20                  # how many top-ranked candidates gemma scores; keep modest so the prompt fits gemma's default context

