{
  "name": "truth-accord-background-worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "dependencies": {
    "cron-parser": "^4.9.0",
    "csv-parse": "^5.5.6",
    "fast-xml-parser": "^4.4.1",
    "node-cron": "^3.0.3",
    "pg": "^8.13.1",
    "playwright": "^1.50.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "eslint": "^10.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.57.1"
  }
}
